{%- capture verified_badge -%}
<div class="liftoff-gr-{{ sid }}__verified">
  <svg class="liftoff-gr-{{ sid }}__verified-icon" width="19" height="23" viewBox="0 0 19 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M9.37431 22.7494C6.7899 22.0415 4.50197 20.5206 2.84891 18.4116C1.19584 16.3027 0.265438 13.7177 0.195312 11.039V3.05504L9.37431 0.240967L18.5533 3.05504V11.039C18.4832 13.7177 17.5528 16.3027 15.8997 18.4116C14.2467 20.5206 11.9587 22.0415 9.37431 22.7494Z" fill="{{ s.accent_color }}"/>
    <path d="M7.8908 12.5368L5.22741 10.0885L3.89624 11.3126L6.55964 13.7609L7.8908 14.9851L9.22199 13.7609L14.5478 8.8633L13.2166 7.63916L7.8908 12.5368Z" fill="white"/>
  </svg>
  <span class="liftoff-gr-{{ sid }}__verified-label">Verified buyer</span>
</div>
{%- endcapture -%}

<section class="liftoff-gr-{{ sid }}">
  <div class="liftoff-gr-{{ sid }}__container">

    {%- if s.heading != blank -%}
      <h2 class="liftoff-gr-{{ sid }}__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- comment -%} Desktop Grid {%- endcomment -%}
    <div class="liftoff-gr-{{ sid }}__grid">

      {%- if s.before_after_image != blank -%}
        <div class="liftoff-gr-{{ sid }}__image-cell">
          {{ s.before_after_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: s.image_alt | default: 'Before and after results' }}
        </div>
      {%- endif -%}

      {%- for block in cards -%}
        <div class="liftoff-gr-{{ sid }}__card liftoff-gr-{{ sid }}__card--{{ forloop.index }}"
             {{ block.shopify_attributes }}>

          <div class="liftoff-gr-{{ sid }}__reviewer">
            <span class="liftoff-gr-{{ sid }}__reviewer-name">{{ block.settings.reviewer_name }}</span>
            {{ verified_badge }}
          </div>

          <div class="liftoff-gr-{{ sid }}__stars">
            {%- assign star_count = block.settings.star_count | default: 5 -%}
            {%- for i in (1..star_count) -%}
              {{ star_svg }}
            {%- endfor -%}
          </div>

          <div class="liftoff-gr-{{ sid }}__review-text">
            {{ block.settings.review_text }}
          </div>
        </div>
      {%- endfor -%}

    </div>

    {%- comment -%} Mobile Layout {%- endcomment -%}
    <div class="liftoff-gr-{{ sid }}__mobile">

      {%- if s.before_after_image != blank -%}
        <div class="liftoff-gr-{{ sid }}__mobile-image">
          {{ s.before_after_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: s.image_alt | default: 'Before and after results' }}
        </div>
      {%- endif -%}

      {%- if cards.size > 0 -%}
        <div class="liftoff-gr-{{ sid }}__slider" data-gr-slider="{{ sid }}">
          <div class="liftoff-gr-{{ sid }}__slides" data-gr-slides>
            {%- for block in cards -%}
              <div class="liftoff-gr-{{ sid }}__slide" {{ block.shopify_attributes }}>
                <div class="liftoff-gr-{{ sid }}__card">

                  <div class="liftoff-gr-{{ sid }}__reviewer">
                    <span class="liftoff-gr-{{ sid }}__reviewer-name">{{ block.settings.reviewer_name }}</span>
                    {{ verified_badge }}
                  </div>

                  <div class="liftoff-gr-{{ sid }}__stars">
                    {%- assign star_count = block.settings.star_count | default: 5 -%}
                    {%- for i in (1..star_count) -%}
                      {{ star_svg }}
                    {%- endfor -%}
                  </div>

                  <div class="liftoff-gr-{{ sid }}__review-text">
                    {{ block.settings.review_text }}
                  </div>

                </div>
              </div>
            {%- endfor -%}
          </div>

          <div class="liftoff-gr-{{ sid }}__slider-nav">
            <button class="liftoff-gr-{{ sid }}__slider-btn" data-gr-prev aria-label="Previous review">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M31.3015 18.1361C31.8907 18.1361 32.3683 17.6585 32.3683 17.0693C32.3683 16.4802 31.8907 16.0025 31.3015 16.0025L31.3015 18.1361ZM9.2113 16.315C8.79469 16.7316 8.79469 17.4071 9.2113 17.8237L16.0003 24.6127C16.4169 25.0293 17.0924 25.0293 17.509 24.6127C17.9256 24.1961 17.9256 23.5206 17.509 23.104L11.4743 17.0693L17.509 11.0346C17.9256 10.618 17.9256 9.94257 17.509 9.52596C17.0924 9.10935 16.4169 9.10935 16.0003 9.52596L9.2113 16.315ZM31.3015 17.0693L31.3015 16.0025L9.96564 16.0025L9.96564 17.0693L9.96564 18.1361L31.3015 18.1361L31.3015 17.0693Z" fill="currentColor"/>
                <circle cx="16.722" cy="16.7132" r="15.6463" transform="rotate(-180 16.722 16.7132)" stroke="currentColor" stroke-width="2.13359"/>
              </svg>
            </button>
            <span class="liftoff-gr-{{ sid }}__slider-label">Swipe to see more</span>
            <button class="liftoff-gr-{{ sid }}__slider-btn" data-gr-next aria-label="Next review">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.1438 15.2906C1.55462 15.2906 1.07701 15.7682 1.07701 16.3574C1.07701 16.9466 1.55462 17.4242 2.1438 17.4242V15.2906ZM24.234 17.1118C24.6506 16.6952 24.6506 16.0197 24.234 15.6031L17.445 8.81405C17.0284 8.39744 16.3529 8.39744 15.9363 8.81405C15.5197 9.23066 15.5197 9.90612 15.9363 10.3227L21.971 16.3574L15.9363 22.3921C15.5197 22.8087 15.5197 23.4842 15.9363 23.9008C16.3529 24.3174 17.0284 24.3174 17.445 23.9008L24.234 17.1118ZM2.1438 16.3574V17.4242H23.4797V16.3574V15.2906L2.1438 15.2906V16.3574Z" fill="currentColor"/>
                <circle cx="16.7234" cy="16.7131" r="15.6463" stroke="currentColor" stroke-width="2.13359"/>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

<script>
  (function() {
    var sid = '{{ sid }}';
    var slider = document.querySelector('[data-gr-slider="' + sid + '"]');
    if (!slider) return;

    var slides = slider.querySelector('[data-gr-slides]');
    var prevBtn = slider.querySelector('[data-gr-prev]');
    var nextBtn = slider.querySelector('[data-gr-next]');
    var totalSlides = slides.children.length;
    var current = 0;

    function update() {
      slides.style.transform = 'translateX(-' + (current * 100) + '%)';
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === totalSlides - 1;
    }

    prevBtn.addEventListener('click', function() {
      if (current > 0) { current--; update(); }
    });

    nextBtn.addEventListener('click', function() {
      if (current < totalSlides - 1) { current++; update(); }
    });

    /* Touch/swipe support */
    var startX = 0;
    var diffX = 0;

    slides.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
    }, { passive: true });

    slides.addEventListener('touchmove', function(e) {
      diffX = e.touches[0].clientX - startX;
    }, { passive: true });

    slides.addEventListener('touchend', function() {
      if (Math.abs(diffX) > 50) {
        if (diffX < 0 && current < totalSlides - 1) { current++; }
        else if (diffX > 0 && current > 0) { current--; }
        update();
      }
      diffX = 0;
    });

    update();
  })();
</script>

