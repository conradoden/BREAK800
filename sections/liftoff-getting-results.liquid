{% comment %}
  ===================================================================================
  LIFTOFF GETTING RESULTS
  ===================================================================================
  Testimonials bento grid with before/after image and review cards.
  Desktop: 4-column grid with image spanning 2 cols + 2 rows, review cards filling the rest.
  Mobile: Image on top, reviews in a fade swiper.

  ********************************************
  Parameters (Schema)
  ********************************************
  * heading (richtext): Section heading with <strong> accent
  * before_after_image (image_picker): Before/after comparison image
  * accent_color / bg_color / card_bg_color / text_color / star_color
  * Blocks: review_card (reviewer_name, review_title, review_text, star_count)

  ********************************************
  Usage
  ********************************************
  Add via Theme Editor → Add Section → Liftoff Getting Results
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign sid = section.id -%}
{%- assign cards = section.blocks -%}

<style>
  .liftoff-gr-{{ sid }} {
    background: {{ s.bg_color }};
    padding: {{ s.padding_top }}px 16px {{ s.padding_bottom }}px;
    color: {{ s.text_color }};
  }

  .liftoff-gr-{{ sid }}__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 4px;
  }

  /* ── Heading ── */
  .liftoff-gr-{{ sid }}__heading {
    font-size: clamp(30px, 4.5vw, 55px);
    font-weight: 900;
    text-align: center;
    line-height: 1.05;
    margin: 0 auto 32px;
    max-width: 313px;
  }
  .liftoff-gr-{{ sid }}__heading strong {
    color: {{ s.accent_color }};
  }

  /* ── Desktop Grid ── */
  .liftoff-gr-{{ sid }}__grid {
    display: none;
    max-width: 1200px;
    margin: 0 auto;
    grid-template-columns: 26.6fr 26.6fr 23fr 36fr;
    gap: 26px;
  }

  /* ── Image cell ── */
  .liftoff-gr-{{ sid }}__image-cell {
    grid-column: span 2;
    grid-row: span 2;
    min-height: 450px;
    border-radius: 23px;
    overflow: hidden;
    position: relative;
  }
  .liftoff-gr-{{ sid }}__image-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 23px;
  }

  /* ── Review Card ── */
  .liftoff-gr-{{ sid }}__card {
    background: {{ s.card_bg_color }};
    padding: 22px 22px 32px;
    border-radius: 21px;
  }

  .liftoff-gr-{{ sid }}__card--1 { grid-column: span 2; order: 1; }
  .liftoff-gr-{{ sid }}__card--2 { grid-column: span 2; order: 2; }
  .liftoff-gr-{{ sid }}__card--3 { grid-column: span 3; order: 3; }
  .liftoff-gr-{{ sid }}__card--4 { grid-column: span 1; order: 4; }

  /* ── Reviewer header ── */
  .liftoff-gr-{{ sid }}__reviewer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .liftoff-gr-{{ sid }}__reviewer-name {
    font-size: 17px;
    line-height: 26px;
    color: #fff;
  }

  /* Verified badge */
  .liftoff-gr-{{ sid }}__verified {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .liftoff-gr-{{ sid }}__verified-icon {
    width: auto;
    height: 23px;
    flex-shrink: 0;
  }
  .liftoff-gr-{{ sid }}__verified-label {
    display: inline-block;
    padding: 5px 20px;
    border-radius: 9999px;
    border: 1px solid {{ s.accent_color }};
    font-size: 12px;
    line-height: 12px;
    color: {{ s.accent_color }};
  }

  /* ── Stars ── */
  .liftoff-gr-{{ sid }}__stars {
    display: flex;
    gap: 5px;
    margin-bottom: 12px;
  }
  .liftoff-gr-{{ sid }}__stars svg {
    height: 19px;
    width: auto;
    color: {{ s.star_color }};
  }

  /* ── Review text ── */
  .liftoff-gr-{{ sid }}__review-text {
    font-size: 17px;
    line-height: 25px;
    color: #fff;
  }
  .liftoff-gr-{{ sid }}__review-text p {
    margin: 0;
  }
  .liftoff-gr-{{ sid }}__review-text p:last-child {
    margin-bottom: 0;
  }
  .liftoff-gr-{{ sid }}__review-text strong {
    font-weight: 700;
  }

  /* ── Mobile Slider ── */
  .liftoff-gr-{{ sid }}__mobile {
    margin-top: 20px;
  }
  .liftoff-gr-{{ sid }}__mobile-image {
    border-radius: 14px;
    overflow: hidden;
    max-width: 350px;
    margin: 0 auto 20px;
  }
  .liftoff-gr-{{ sid }}__mobile-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 14px;
  }

  .liftoff-gr-{{ sid }}__slider {
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .liftoff-gr-{{ sid }}__slides {
    display: flex;
    flex-wrap: nowrap;
    transition: transform 0.4s ease;
    width: 100%;
  }
  .liftoff-gr-{{ sid }}__slide {
    width: 100%;
    min-width: 100%;
    flex-shrink: 0;
    padding: 0 4px;
    box-sizing: border-box;
  }
  .liftoff-gr-{{ sid }}__slide .liftoff-gr-{{ sid }}__card {
    height: 100%;
  }

  /* ── Slider nav ── */
  .liftoff-gr-{{ sid }}__slider-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
  }
  .liftoff-gr-{{ sid }}__slider-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #fff;
    transition: color 0.3s ease;
  }
  .liftoff-gr-{{ sid }}__slider-btn:disabled {
    color: #555;
    cursor: default;
  }
  .liftoff-gr-{{ sid }}__slider-btn svg {
    height: 34px;
    width: auto;
  }
  .liftoff-gr-{{ sid }}__slider-label {
    text-transform: uppercase;
    font-weight: 700;
    font-size: 18px;
    line-height: 30px;
    text-align: center;
  }

  /* ── Desktop overrides ── */
  @media (min-width: 990px) {
    .liftoff-gr-{{ sid }} {
      padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    }
    .liftoff-gr-{{ sid }}__heading {
      max-width: 1066px;
      margin-bottom: 62px;
    }
    .liftoff-gr-{{ sid }}__grid {
      display: grid;
    }
    .liftoff-gr-{{ sid }}__mobile {
      display: none;
    }
    .liftoff-gr-{{ sid }}__card {
      padding: 24px 32px 32px;
    }
    .liftoff-gr-{{ sid }}__reviewer-name {
      font-size: 19px;
      line-height: 28px;
    }
    .liftoff-gr-{{ sid }}__review-text {
      font-size: 19px;
      line-height: 28px;
    }
    .liftoff-gr-{{ sid }}__image-cell {
      min-height: 558px;
    }
  }

  @media (min-width: 750px) and (max-width: 989px) {
    .liftoff-gr-{{ sid }}__mobile-image {
      max-width: 450px;
      min-height: 450px;
    }
    .liftoff-gr-{{ sid }}__mobile-image img {
      height: 100%;
      object-fit: cover;
    }
  }
</style>

{%- capture star_svg -%}
