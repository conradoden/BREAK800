{% comment %}
  ===================================================================================
  INGREDIENTS GRID
  ===================================================================================
  "8 Ingredients in 1 Powerful Formula" — 4×2 grid of ingredient cards.
  Each card uses the ingredient image as a full background with a dark gradient
  overlay; title + description sit on top, dosage shown in a white pill in the
  bottom-right corner.

  Optional trust badges row + "lab tested" callout + CTA below.

  ********************************************
  Parameters (Schema)
  ********************************************
  * heading (text), sub_heading (text)
  * cta_text / cta_link
  * lab_text (text), lab_date (text), lab_subtext (text), lab_link (url), lab_icon (image_picker)
  * bg_color (color_background, transparent default)
  * accent_color (color, default #ff5600)
  * Blocks: ingredient (image, title, dosage, description) | trust_badge (icon, text)

  ********************************************
  Usage
  ********************************************
  Add via Shopify Theme Editor → Add Section → Ingredients Grid
{% endcomment %}

<style>
  .ingredients-grid-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 70px 20px;
    color: {{ section.settings.text_color }};
  }

  .ingredients-grid__container-{{ section.id }} {
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
  }

  .ingredients-grid__heading-{{ section.id }} {
    
    font-size: clamp(30px, 4.2vw, 46px);
    font-weight: 800;
    margin: 0 0 14px;
    line-height: 1.15;
    color: {{ section.settings.text_color }};
  }

  .ingredients-grid__sub-heading-{{ section.id }} {
    display: block;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 38px;
  }

  .ingredients-grid__cards-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    margin-bottom: 36px;
  }

  .ingredients-grid__card-{{ section.id }} {
    position: relative;
    width: calc(25% - 14px);
    aspect-ratio: 1.25 / 1;
    border-radius: 14px;
    overflow: hidden;
    background-color: #1a1a1a;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 22px;
    isolation: isolate;
  }

  .ingredients-grid__card-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--card-overlay, linear-gradient(135deg, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.45) 45%, rgba(0,0,0,0.15) 100%));
    z-index: 0;
  }

  .ingredients-grid__card-title-{{ section.id }} {
    position: relative;
    z-index: 1;
    
    font-size: 26px;
    font-weight: 800;
    margin: 0 0 8px;
    line-height: 1.1;
    color: #ffffff;
  }

  .ingredients-grid__card-desc-{{ section.id }} {
    position: relative;
    z-index: 1;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255,255,255,0.85);
    margin: 0;
    max-width: 90%;
  }

  .ingredients-grid__card-dosage-{{ section.id }} {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    background: #ffffff;
    color: #111111;
    
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 6px 14px;
    border-radius: 999px;
    line-height: 1;
  }

  /* Trust Badges Row */
  .ingredients-grid__badges-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin: 30px 0 25px;
    padding: 22px 4px 0;
    border-top: 1px solid rgba(255,255,255,0.12);
  }

  .ingredients-grid__badge-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: rgba(255,255,255,0.85);
    white-space: nowrap;
  }

  .ingredients-grid__badge-{{ section.id }} img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  /* Lab callout */
  .ingredients-grid__lab-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 12px 22px;
    border-radius: 10px;
    margin: 0 auto 30px;
    text-decoration: none;
    color: inherit;
  }

  .ingredients-grid__lab-icon-{{ section.id }} {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: #4f5bd5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
  }

  .ingredients-grid__lab-icon-{{ section.id }} img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .ingredients-grid__lab-text-{{ section.id }} {
    text-align: left;
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255,255,255,0.9);
  }

  .ingredients-grid__lab-text-{{ section.id }} strong {
    font-weight: 600;
    color: #ffffff;
  }

  .ingredients-grid__lab-date-{{ section.id }} {
    display: inline-block;
    background: #d6dbff;
    color: #4f5bd5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 6px;
    vertical-align: middle;
  }

  /* CTA */
  .ingredients-grid__cta-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--bk-btn-bg);
    color: var(--bk-btn-text);
    border: 2px solid var(--bk-btn-bg);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 18px 56px;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: background .3s ease, border-color .3s ease, color .3s ease, transform .2s ease, box-shadow .2s ease;
    box-shadow: 0 10px 30px -8px rgba(139, 32, 32, 0.6);
    margin-top: 10px;
  }

  .ingredients-grid__cta-{{ section.id }}:hover {
    background: transparent;
    border-color: var(--bk-btn-bg);
    color: var(--bk-btn-bg);
    box-shadow: none;
    transform: translateY(-2px);
  }

  @media (max-width: 999px) {
    .ingredients-grid__card-{{ section.id }} {
      width: calc(50% - 10px);
    }
  }

  @media (max-width: 549px) {
    .ingredients-grid-{{ section.id }} {
      padding: 50px 16px;
    }
    .ingredients-grid__heading-{{ section.id }} {
      font-size: 28px;
    }
    .ingredients-grid__sub-heading-{{ section.id }} {
      font-size: 12px;
      letter-spacing: 2px;
      margin-bottom: 24px;
    }
    .ingredients-grid__card-{{ section.id }} {
      width: calc(50% - 6px);
    }
    .ingredients-grid__cards-{{ section.id }} {
      gap: 12px;
    }
    .ingredients-grid__card-{{ section.id }} {
      aspect-ratio: auto;
      padding: 40px 8px 8px;
      align-items: center;
      justify-content: flex-start;
      text-align: center;
    }
    .ingredients-grid__card-{{ section.id }}::before {
      background: var(--card-overlay, linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.78) 55%, rgba(0,0,0,0.92) 100%));
    }
    .ingredients-grid__card-title-{{ section.id }} {
      font-size: 19px;
      margin: 0 0 8px;
      text-align: center;
      max-width: 100%;
      word-wrap: break-word;
    }
    .ingredients-grid__card-desc-{{ section.id }} {
      font-size: 12px;
      max-width: 100%;
      text-align: center;
    }
    .ingredients-grid__card-dosage-{{ section.id }} {
      position: absolute;
      top: 14px;
      left: 50%;
      right: auto;
      bottom: auto;
      transform: translateX(-50%);
      font-size: 11px;
      padding: 4px 12px;
      white-space: nowrap;
    }
    .ingredients-grid__badges-{{ section.id }} {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 18px;
      justify-content: stretch;
      padding: 22px 4px 0;
    }
    .ingredients-grid__badge-{{ section.id }} {
      justify-content: flex-start;
      white-space: normal;
      font-size: 13px;
      line-height: 1.25;
      text-align: left;
    }
    .ingredients-grid__cta-{{ section.id }} {
      width: 100%;
      justify-content: center;
      padding: 16px 20px;
    }
  }
</style>

<div class="ingredients-grid-{{ section.id }}">
  <div class="ingredients-grid__container-{{ section.id }}">

    {%- if section.settings.heading != blank -%}
      <h2 class="ingredients-grid__heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.sub_heading != blank -%}
      <span class="ingredients-grid__sub-heading-{{ section.id }}">{{ section.settings.sub_heading }}</span>
    {%- endif -%}

    {%- assign ingredient_blocks = section.blocks | where: "type", "ingredient" -%}
    {%- assign badge_blocks = section.blocks | where: "type", "trust_badge" -%}

    {%- if ingredient_blocks.size > 0 -%}
      <div class="ingredients-grid__cards-{{ section.id }}">
        {%- for block in ingredient_blocks -%}
          {%- assign card_bg = '' -%}
          {%- if block.settings.image != blank -%}
            {%- assign card_bg = block.settings.image | image_url: width: 600 -%}
          {%- endif -%}
          {%- capture card_style -%}
            {%- if card_bg != '' -%}background-image: url('{{ card_bg }}');{%- endif -%}
            {%- if block.settings.gradient != blank -%}--card-overlay: {{ block.settings.gradient }};{%- endif -%}
          {%- endcapture -%}
          <div
            class="ingredients-grid__card-{{ section.id }}"
            {% if card_style != blank %}style="{{ card_style | strip }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.title != blank -%}
              <h3 class="ingredients-grid__card-title-{{ section.id }}">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="ingredients-grid__card-desc-{{ section.id }}">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.dosage != blank -%}
              <span class="ingredients-grid__card-dosage-{{ section.id }}">{{ block.settings.dosage }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if badge_blocks.size > 0 -%}
      <div class="ingredients-grid__badges-{{ section.id }}">
        {%- for block in badge_blocks -%}
          <div class="ingredients-grid__badge-{{ section.id }}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <img
                src="{{ block.settings.icon | image_url: width: 44 }}"
                alt=""
                width="22"
                height="22"
                loading="lazy"
              >
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.lab_text != blank -%}
      {%- if section.settings.lab_link != blank -%}
        <a href="{{ section.settings.lab_link }}" class="ingredients-grid__lab-{{ section.id }}">
      {%- else -%}
        <div class="ingredients-grid__lab-{{ section.id }}">
      {%- endif -%}
          <span class="ingredients-grid__lab-icon-{{ section.id }}">
            {%- if section.settings.lab_icon != blank -%}
              <img src="{{ section.settings.lab_icon | image_url: width: 36 }}" alt="" width="18" height="18" loading="lazy">
            {%- else -%}
              &#10003;
            {%- endif -%}
          </span>
          <span class="ingredients-grid__lab-text-{{ section.id }}">
            {{ section.settings.lab_text }}
            {%- if section.settings.lab_date != blank -%}
              <span class="ingredients-grid__lab-date-{{ section.id }}">{{ section.settings.lab_date }}</span>
            {%- endif -%}
            {%- if section.settings.lab_subtext != blank -%}
              <br><strong>{{ section.settings.lab_subtext }}</strong>
            {%- endif -%}
          </span>
      {%- if section.settings.lab_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
      <br>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link | default: '#' }}" class="ingredients-grid__cta-{{ section.id }}">
        {{ section.settings.cta_text }} <span aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Ingredients Grid",
  "tag": "section",
  "class": "ingredients-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "8 Ingredients in 1 Powerful Formula"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "Clinically Dosed + Effective"
    },
    {
      "type": "header",
      "content": "Lab-Tested Callout"
    },
    {
      "type": "text",
      "id": "lab_text",
      "label": "Callout Text",
      "default": "Tested by Light Labs in"
    },
    {
      "type": "text",
      "id": "lab_date",
      "label": "Test Date Pill",
      "default": "APR 2026"
    },
    {
      "type": "text",
      "id": "lab_subtext",
      "label": "Sub Text",
      "default": "9 substances tested for quality →"
    },
    {
      "type": "url",
      "id": "lab_link",
      "label": "Callout Link"
    },
    {
      "type": "image_picker",
      "id": "lab_icon",
      "label": "Callout Icon"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "TRY IT NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background (transparent by default)",
      "default": "rgba(0,0,0,0.3)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / CTA Color",
      "default": "#ff5600"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tongkat Ali"
        },
        {
          "type": "text",
          "id": "dosage",
          "label": "Dosage Pill",
          "default": "1,000 mg"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Boosts testosterone, enhances libido, improves fertility, and supports muscle growth."
        },
        {
          "type": "color_background",
          "id": "gradient",
          "label": "Overlay Gradient",
          "info": "Optional. Overrides the default dark overlay. Accepts a solid color or CSS gradient (e.g. linear-gradient(135deg, rgba(255,86,0,0.85), rgba(0,0,0,0.6)))."
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Made In A cGMP Facility"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Grid",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "Tongkat Ali", "dosage": "1,000 mg", "description": "Boosts testosterone, enhances libido, improves fertility, and supports muscle growth." } },
        { "type": "ingredient", "settings": { "title": "Shilajit", "dosage": "400 mg", "description": "Improves fertility and boosts testosterone levels." } },
        { "type": "ingredient", "settings": { "title": "K1 & K2", "dosage": "100 mcg", "description": "Supports bone health and density, improves mood, and encourages testosterone production." } },
        { "type": "ingredient", "settings": { "title": "Vitamin D", "dosage": "4,000 IU", "description": "Essential for maintaining cellular health and helping regulate testosterone production." } },
        { "type": "ingredient", "settings": { "title": "Zinc", "dosage": "30 mg", "description": "An essential trace mineral that plays a role in testosterone metabolism and immune function." } },
        { "type": "ingredient", "settings": { "title": "Taurine", "dosage": "675 mg", "description": "Reduces oxidative stress, improves blood flow, and supports increased testosterone levels." } },
        { "type": "ingredient", "settings": { "title": "Fenugreek", "dosage": "675 mg", "description": "Supports testosterone production, DHT levels, and male vitality." } },
        { "type": "ingredient", "settings": { "title": "Boron", "dosage": "4 mg", "description": "A trace mineral with the potential to increase free testosterone and regulate estrogen levels." } },
        { "type": "trust_badge", "settings": { "text": "Made In A cGMP Facility" } },
        { "type": "trust_badge", "settings": { "text": "Hormone-Free" } },
        { "type": "trust_badge", "settings": { "text": "Non-GMO" } },
        { "type": "trust_badge", "settings": { "text": "Vegan" } },
        { "type": "trust_badge", "settings": { "text": "Third Party Tested" } },
        { "type": "trust_badge", "settings": { "text": "Made in USA" } }
      ]
    }
  ]
}
{% endschema %}
