{% comment %}
  ===================================================================================
  LIFTOFF REAL RESULTS
  ===================================================================================
  "Real Results" — 3 stat rows with animated progress bars that fill on scroll.
  Each row: large percentage number, bordered progress bar with SVG bubble badge,
  and a description with highlighted word.

  ********************************************
  Parameters (Schema)
  ********************************************
  * heading (text), footnote (richtext)
  * cta_text / cta_link
  * accent_color / text_color / bg_color
  * Blocks: stat (percentage, description, highlight_word)

  ********************************************
  Usage
  ********************************************
  Add via Shopify Theme Editor → Add Section → Liftoff Real Results
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign sid = section.id -%}
{%- assign stats = section.blocks -%}

<style>
  .liftoff-results-{{ sid }} {
    background: {{ s.bg_color }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    color: {{ s.text_color }};
  }

  .liftoff-results-{{ sid }}__container {
    max-width: 1005px;
    margin: 0 auto;
  }

  .liftoff-results-{{ sid }}__heading {
    
    font-size: clamp(25px, 4vw, 55px);
    font-weight: 900;
    text-align: center;
    margin: 0 0 16px;
    line-height: 1.08;
  }

  .liftoff-results-{{ sid }}__footnote {
    font-size: 14px;
    line-height: 1.32;
    text-align: center;
    margin: 0 auto 28px;
    max-width: 750px;
  }

  .liftoff-results-{{ sid }}__footnote p {
    margin: 0;
  }

  /* Stat list */
  .liftoff-results-{{ sid }}__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Stat row */
  .liftoff-results-{{ sid }}__stat {
    padding: 0;
  }

  .liftoff-results-{{ sid }}__stat + .liftoff-results-{{ sid }}__stat {
    margin-top: 24px;
  }

  .liftoff-results-{{ sid }}__stat-top {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 6px;
  }

  .liftoff-results-{{ sid }}__percentage {
    
    font-size: clamp(35px, 4.5vw, 55px);
    font-weight: 900;
    line-height: 1.18;
    color: {{ s.text_color }};
    flex-shrink: 0;
    margin: 0;
  }

  .liftoff-results-{{ sid }}__desc {
    font-size: 20px;
    line-height: 1.32;
    color: rgba(255, 255, 255, 0.85);
  }

  .liftoff-results-{{ sid }}__desc p {
    margin: 0;
  }

  .liftoff-results-{{ sid }}__desc .highlight {
    color: {{ s.accent_color }};
    font-weight: 700;
  }

  .liftoff-results-{{ sid }}__desc--desktop {
    display: block;
  }

  .liftoff-results-{{ sid }}__desc--mobile {
    display: none;
    font-size: 14px;
    line-height: 1.32;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 4px;
  }

  .liftoff-results-{{ sid }}__desc--mobile p {
    margin: 0;
  }

  .liftoff-results-{{ sid }}__desc--mobile .highlight {
    color: {{ s.accent_color }};
    font-weight: 700;
  }

  /* Progress bar - bordered track */
  .liftoff-results-{{ sid }}__bar-track {
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 6px;
    padding: 6px;
    position: relative;
  }

  .liftoff-results-{{ sid }}__bar {
    height: 12px;
    width: 0%;
    background: linear-gradient(90deg, {{ s.bar_color_start }}, {{ s.bar_color_end }});
    border-radius: 4px;
    transition: width 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
  }

  .liftoff-results-{{ sid }}__bar.animated {
    width: var(--bar-width);
  }

  /* SVG speech bubble badge */
  .liftoff-results-{{ sid }}__bar-badge {
    position: absolute;
    right: -23px;
    top: -46px;
    opacity: 0;
    transition: opacity .4s ease .8s;
  }

  .liftoff-results-{{ sid }}__bar-badge.animated {
    opacity: 1;
  }

  /* CTA */
  .liftoff-results-{{ sid }}__cta-wrap {
    text-align: center;
    margin-top: 50px;
  }

  .liftoff-results-{{ sid }}__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--bk-btn-bg);
    color: var(--bk-btn-text);
    border: 2px solid var(--bk-btn-bg);
    border-radius: 8px;
    padding: 18px 54px;
    
    font-size: clamp(15px, 1.3vw, 18px);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background .3s ease, border-color .3s ease, color .3s ease, transform .2s ease, box-shadow .2s ease;
    box-shadow: 0 10px 30px -8px rgba(139, 32, 32, 0.6);
  }

  .liftoff-results-{{ sid }}__cta:hover {
    background: transparent;
    border-color: var(--bk-btn-bg);
    color: var(--bk-btn-bg);
    box-shadow: none;
    transform: translateY(-2px);
  }

  .liftoff-results-{{ sid }}__cta svg {
    width: 20px;
    height: 20px;
  }
  .liftoff-results-{{ sid }}__cta:hover svg path {
    fill: var(--bk-btn-bg);
  }
  @media (min-width: 1024px) {
    .liftoff-results-{{ sid }}__stat + .liftoff-results-{{ sid }}__stat {
      margin-top: 40px;
    }

    .liftoff-results-{{ sid }}__stat-top {
      margin-bottom: 20px;
    }
  }

  @media (max-width: 1023px) {
    .liftoff-results-{{ sid }}__desc--desktop {
      display: none;
    }

    .liftoff-results-{{ sid }}__desc--mobile {
      display: block;
    }

    .liftoff-results-{{ sid }}__percentage {
      font-size: 35px;
      line-height: 1.18;
    }
  }

  @media (max-width: 768px) {
    .liftoff-results-{{ sid }} {
      padding: {{ s.padding_top_mb }}px 16px {{ s.padding_bottom_mb }}px;
    }

    .liftoff-results-{{ sid }}__cta {
      width: 100%;
      padding: 18px 32px;
    }
  }
</style>

<section class="liftoff-results-{{ sid }}" id="liftoff-results-{{ sid }}">
  <div class="liftoff-results-{{ sid }}__container">

    {%- if s.heading != blank -%}
      <h2 class="liftoff-results-{{ sid }}__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.footnote != blank -%}
      <div class="liftoff-results-{{ sid }}__footnote">{{ s.footnote }}</div>
    {%- endif -%}

    {%- if stats.size > 0 -%}
      <ul class="liftoff-results-{{ sid }}__list">
        {%- for block in stats -%}
          {%- capture desc_html -%}
            {%- if block.settings.highlight_word != blank -%}
              {%- assign highlight_open = '<span class="highlight">' | append: block.settings.highlight_word | append: '</span>' -%}
              {{ block.settings.description | replace: block.settings.highlight_word, highlight_open }}
            {%- else -%}
              {{ block.settings.description }}
            {%- endif -%}
          {%- endcapture -%}

          <li class="liftoff-results-{{ sid }}__stat" {{ block.shopify_attributes }}>
            <div class="liftoff-results-{{ sid }}__stat-top">
              <p class="liftoff-results-{{ sid }}__percentage">{{ block.settings.percentage }}%</p>
              <div class="liftoff-results-{{ sid }}__desc liftoff-results-{{ sid }}__desc--desktop">
                <p>{{ desc_html }}</p>
              </div>
            </div>
            <div class="liftoff-results-{{ sid }}__bar-track">
              <div class="liftoff-results-{{ sid }}__bar" style="--bar-width: {{ block.settings.percentage }}%">
                <span class="liftoff-results-{{ sid }}__bar-badge">
                  <svg width="49" height="30" viewBox="0 0 49 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1.07031 4C1.07031 2.067 2.63732 0.5 4.57031 0.5H44.5703C46.5033 0.5 48.0703 2.067 48.0703 4V22C48.0703 23.933 46.5033 25.5 44.5703 25.5H36.5703H31.7814C30.893 25.5 30.0245 25.763 29.2853 26.2558L24.5703 29.3991L19.8554 26.2558C19.1162 25.763 18.2476 25.5 17.3592 25.5H12.5703H4.57031C2.63732 25.5 1.07031 23.933 1.07031 22V4Z" stroke="white" fill="black"/>
                    <text x="50%" y="50%" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="14" font-weight="700">{{ block.settings.percentage }}%</text>
                  </svg>
                </span>
              </div>
            </div>
            <div class="liftoff-results-{{ sid }}__desc--mobile">
              <p>{{ desc_html }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.cta_text != blank -%}
      <div class="liftoff-results-{{ sid }}__cta-wrap">
        <a href="{{ s.cta_link | default: '#' }}" class="liftoff-results-{{ sid }}__cta">
          {{ s.cta_text }}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function() {
    var section = document.getElementById('liftoff-results-{{ sid }}');
    if (!section) return;

    var bars = section.querySelectorAll('.liftoff-results-{{ sid }}__bar');
    var badges = section.querySelectorAll('.liftoff-results-{{ sid }}__bar-badge');
    var observed = false;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting && !observed) {
          observed = true;
          bars.forEach(function(bar, i) {
            setTimeout(function() {
              bar.classList.add('animated');
              if (badges[i]) badges[i].classList.add('animated');
            }, i * 200);
          });
          observer.disconnect();
        }
      });
    }, { threshold: 0.3 });

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "BK Liftoff Real Results",
  "tag": "section",
  "class": "bk-section-liftoff-results",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>*These results are based on customer-reported survey feedback from verified purchasers and are not intended to represent clinical or medical outcomes.</p>"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "TRY IT NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#8B2020"
    },
    {
      "type": "color",
      "id": "bar_color_start",
      "label": "Bar gradient start",
      "default": "#983301"
    },
    {
      "type": "color",
      "id": "bar_color_end",
      "label": "Bar gradient end",
      "default": "#FE5601"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F4EFE8"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0.3)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 108
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Bar",
      "settings": [
        {
          "type": "range",
          "id": "percentage",
          "label": "Percentage",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 91
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Said they felt they have higher energy after using this product."
        },
        {
          "type": "text",
          "id": "highlight_word",
          "label": "Highlight word (accent color)",
          "default": "higher energy",
          "info": "This word/phrase will be highlighted in the accent color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BK Liftoff Real Results",
      "blocks": [
        { "type": "stat", "settings": { "percentage": 91, "description": "Said they felt they have higher energy after using this product.", "highlight_word": "higher energy" } },
        { "type": "stat", "settings": { "percentage": 82, "description": "Said they noticed improved male vitality after using this product.", "highlight_word": "improved male vitality" } },
        { "type": "stat", "settings": { "percentage": 87, "description": "Said they noticed increased strength after using this product.", "highlight_word": "increased strength" } }
      ]
    }
  ]
}
{% endschema %}
