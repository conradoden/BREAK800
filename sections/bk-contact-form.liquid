{% comment %}
  ===================================================================================
  CONTACT / PRESS FORM SECTION
  ===================================================================================
  Functional Shopify contact form (uses {% form 'contact' %}) styled to match the
  BREAK800 brand: dark grunge background, orange accent borders, uppercase labels,
  large pill CTA button.

  Reusable on both /pages/press and /pages/contact (the email recipient is set in
  Shopify Admin → Settings → Notifications → Contact form, or via the page itself).

  ********************************************
  Parameters (Schema)
  ********************************************
  * eyebrow (text)            — small orange line above title
  * heading (text)            — large white headline (PRESS PAGE / CONTACT US)
  * sub_text (richtext)       — paragraph with contact email link
  * show_arrow (checkbox)     — show arrow on Send Message button
  * button_text (text)
  * success_text (text)
  * bg_image (image_picker)   — full background (defaults to dark grunge)
  * bg_color (color)
  * accent_color (color)      — borders + eyebrow + CTA bg
  * text_color (color)

  ********************************************
  Usage
  ********************************************
  Add via Shopify Theme Editor → Add Section → Contact / Press Form
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign uid = section.id -%}

<style>
  .contact-form-{{ uid }} {
    position: relative;
    background-color: {{ s.bg_color }};
    {%- if s.bg_image != blank %}
      background-image: url('{{ s.bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {%- endif %}
    color: {{ s.text_color }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    overflow: hidden;
  }

  .contact-form-{{ uid }}__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,{{ s.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  .contact-form-{{ uid }}__inner {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .contact-form-{{ uid }}__eyebrow {
    font-family: 'foldgrotesqueboldpro', 'Inter', sans-serif;
    color: {{ s.accent_color }};
    font-size: clamp(14px, 1.4vw, 18px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 14px;
    font-weight: 700;
  }

  .contact-form-{{ uid }}__heading {
    font-family: 'foldgrotesqueboldpro', 'Inter', sans-serif;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0 0 22px;
    color: {{ s.text_color }};
  }

  .contact-form-{{ uid }}__sub {
    font-family: 'foldgrotesqueboldpro', 'Inter', sans-serif;
    font-size: clamp(14px, 1.3vw, 16px);
    line-height: 1.55;
    margin: 0 auto 40px;
    max-width: 520px;
    font-weight: 600;
  }

  .contact-form-{{ uid }}__sub a {
    color: {{ s.text_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-form-{{ uid }}__sub a:hover {
    color: {{ s.accent_color }};
  }

  .contact-form-{{ uid }} form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    text-align: left;
  }

  .contact-form-{{ uid }} .field {
    position: relative;
  }

  .contact-form-{{ uid }} .field input,
  .contact-form-{{ uid }} .field textarea {
    width: 100%;
    background: #000;
    color: {{ s.text_color }};
    border: 1.5px solid {{ s.accent_color }};
    border-radius: 10px;
    padding: 22px 22px 10px;
    font-family: 'foldgrotesqueboldpro', 'Inter', sans-serif;
    font-size: 15px;
    letter-spacing: 0.04em;
    outline: none;
    transition: border-color .2s ease, box-shadow .2s ease;
    box-sizing: border-box;
  }

  .contact-form-{{ uid }} .field textarea {
    min-height: 160px;
    resize: vertical;
    padding-top: 26px;
  }

  .contact-form-{{ uid }} .field input:focus,
  .contact-form-{{ uid }} .field textarea:focus {
    border-color: {{ s.accent_color }};
    box-shadow: 0 0 0 3px rgba(255, 86, 0, 0.18);
  }

  .contact-form-{{ uid }} .field label {
    position: absolute;
    top: 14px;
    left: 22px;
    font-family: 'foldgrotesqueboldpro', 'Inter', sans-serif;
    color: {{ s.text_color }};
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    pointer-events: none;
    font-weight: 700;
    transition: top .15s ease, font-size .15s ease, color .15s ease;
  }

  .contact-form-{{ uid }} .field input:focus + label,
  .contact-form-{{ uid }} .field input:not(:placeholder-shown) + label,
  .contact-form-{{ uid }} .field textarea:focus + label,
  .contact-form-{{ uid }} .field textarea:not(:placeholder-shown) + label {
    top: 6px;
    font-size: 10px;
    color: {{ s.accent_color }};
  }

  .contact-form-{{ uid }} .field .req {
    color: {{ s.accent_color }};
    margin-left: 2px;
  }

  .contact-form-{{ uid }}__submit-wrap {
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }

  .contact-form-{{ uid }}__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: {{ s.accent_color }};
    color: #fff;
    border: none;
    outline: none;
    border-radius: 8px;
    padding: 22px 70px;
    font-family: 'foldgrotesqueboldpro', 'Inter', sans-serif;
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    box-shadow: 0 10px 25px -10px rgba(255, 86, 0, 0.6);
  }

  .contact-form-{{ uid }}__submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -12px rgba(255, 86, 0, 0.75);
    outline: none;
  }

  .contact-form-{{ uid }}__submit:focus {
    outline: none;
  }

  .contact-form-{{ uid }}__submit svg {
    width: 22px;
    height: 22px;
  }

  .contact-form-{{ uid }}__success,
  .contact-form-{{ uid }}__errors {
    border-radius: 10px;
    padding: 14px 18px;
    margin: 0 0 24px;
    font-family: 'foldgrotesqueboldpro', 'Inter', sans-serif;
    font-size: 14px;
    text-align: left;
  }

  .contact-form-{{ uid }}__success {
    background: rgba(40, 180, 99, 0.15);
    border: 1px solid rgba(40, 180, 99, 0.6);
    color: #d6f5e3;
  }

  .contact-form-{{ uid }}__errors {
    background: rgba(255, 86, 0, 0.12);
    border: 1px solid {{ s.accent_color }};
    color: #ffd9c2;
  }

  .contact-form-{{ uid }}__errors ul {
    margin: 6px 0 0;
    padding-left: 18px;
  }

  @media (max-width: 600px) {
    .contact-form-{{ uid }} {
      padding: {{ s.padding_top_mb }}px 16px {{ s.padding_bottom_mb }}px;
    }
    .contact-form-{{ uid }}__submit {
      padding: 18px 40px;
      width: 100%;
    }
  }
</style>

<section class="contact-form-{{ uid }}">
  <div class="contact-form-{{ uid }}__overlay"></div>
  <div class="contact-form-{{ uid }}__inner">

    {%- if s.eyebrow != blank -%}
      <p class="contact-form-{{ uid }}__eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h1 class="contact-form-{{ uid }}__heading">{{ s.heading }}</h1>
    {%- endif -%}

    {%- if s.sub_text != blank -%}
      <div class="contact-form-{{ uid }}__sub">{{ s.sub_text }}</div>
    {%- endif -%}

    {%- form 'contact' -%}
      {%- if s.form_source != blank -%}
        <input type="hidden" name="contact[_source]" value="{{ s.form_source }}">
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div class="contact-form-{{ uid }}__success" role="status">
          {{ s.success_text | default: 'Thanks for reaching out — we’ll be in touch shortly.' }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="contact-form-{{ uid }}__errors" role="alert">
          <strong>Please fix the following:</strong>
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <input
          type="text"
          id="ContactName-{{ uid }}"
          name="contact[{{ 'templates.contact.form.name' | t }}]"
          autocomplete="name"
          placeholder=" "
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          required
        >
        <label for="ContactName-{{ uid }}">Name<span class="req">*</span></label>
      </div>

      <div class="field">
        <input
          type="email"
          id="ContactEmail-{{ uid }}"
          name="contact[email]"
          autocomplete="email"
          spellcheck="false"
          autocapitalize="off"
          placeholder=" "
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          required
        >
        <label for="ContactEmail-{{ uid }}">Email<span class="req">*</span></label>
      </div>

      <div class="field">
        <textarea
          id="ContactMessage-{{ uid }}"
          name="contact[body]"
          rows="6"
          placeholder=" "
          required
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        <label for="ContactMessage-{{ uid }}">Message<span class="req">*</span></label>
      </div>

      <div class="contact-form-{{ uid }}__submit-wrap">
        <button type="submit" class="contact-form-{{ uid }}__submit">
          {{ s.button_text | default: 'Send Message' }}
          {%- if s.show_arrow -%}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- endif -%}
        </button>
      </div>

    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "BK Contact Form",
  "tag": "section",
  "class": "bk-section-contact-form",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WE'RE HERE TO ASSIST YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PRESS PAGE"
    },
    {
      "type": "richtext",
      "id": "sub_text",
      "label": "Sub text",
      "default": "<p>Please fill out the contact form below or email us directly at <a href=\"mailto:press@mengotomars.com\">press@mengotomars.com.</a></p>"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Send Message"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow on button",
      "default": false
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks for reaching out — we’ll be in touch shortly."
    },
    {
      "type": "header",      "content": "Email Routing"
    },
    {
      "type": "text",
      "id": "recipient_email",
      "label": "Recipient email (optional)",
      "info": "Use Shopify Automations or Zapier to route to this email"
    },
    {
      "type": "text",
      "id": "form_source",
      "label": "Form source identifier",
      "default": "press",
      "info": "e.g., 'press' or 'contact' — use in automations to route to different emails"
    },
    {
      "type": "header",      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0.3)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff5600"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Press Form",
      "settings": {
        "heading": "PRESS PAGE",
        "sub_text": "<p>Please fill out the contact form below or email us directly at <a href=\"mailto:press@mengotomars.com\">press@mengotomars.com.</a></p>",
        "form_source": "press"
      }
    },
    {
      "name": "Contact Form",
      "settings": {
        "heading": "CONTACT US",
        "sub_text": "<p>Please fill out the contact form below or email us directly at <a href=\"mailto:liftoff@mengotomars.com\">liftoff@mengotomars.com.</a></p>",
        "form_source": "contact"
      }
    }  
  ]
}
{% endschema %}
